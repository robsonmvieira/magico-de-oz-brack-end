# Test Environment (Docker for Tests)
NODE_ENV=test

# Database - Test Docker Container
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=magicoDb_test
DB_LOGGING=false

# Redis - Test Docker Container
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# RabbitMQ - Test Docker Container
RABBITMQ_URI=amqp://guest:guest@localhost:5673

# JWT
JWT_SECRET=test-secret-only-for-tests
JWT_EXPIRES_IN=1h

# Email (disabled in tests)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=

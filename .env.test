# Test Environment (Docker for Tests)
NODE_ENV=test

# Database - Test Docker Container
DB_HOST=db-test
DB_PORT=5432
DB_USERNAME=test
DB_PASSWORD=test
DB_DATABASE=test_db
DB_LOGGING=false
DATABASE_URL=postgresql://test:test@db-test:5432/test_db

# Redis - Test Docker Container
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# RabbitMQ - Test Docker Container
RABBITMQ_URI=amqp://guest:guest@localhost:5673

# JWT
JWT_SECRET=test-secret-only-for-tests
JWT_EXPIRES_IN=1h

# Email (disabled in tests)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Environment Configuration Example
# Copy this file to .env.local, .env.development, .env.test, or .env.production

NODE_ENV=local

# Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=magicoDb
DB_LOGGING=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URI=amqp://admin:admin@rabbitmq:5672

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=8h

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# AWS (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_URL=

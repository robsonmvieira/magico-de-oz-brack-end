# Development Environment (Remote Services)
NODE_ENV=development

# Database - Remote Dev Server
DB_HOST=your-dev-db-host.example.com
DB_PORT=5432
DB_USERNAME=dev_user
DB_PASSWORD=dev_password
DB_DATABASE=magicoDb_dev
DB_LOGGING=true

# Redis - Remote Dev Server
REDIS_HOST=your-dev-redis-host.example.com
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ - Remote Dev Server
RABBITMQ_URI=amqp://dev_user:dev_password@your-dev-rabbitmq.example.com:5672

# JWT
JWT_SECRET=change-this-secret-in-dev
JWT_EXPIRES_IN=8h

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_URL=
